(version 1)
(deny default file-link)
(import "system.sb")
(allow process-exec*)
(allow process-fork)
(allow file-read-metadata)
(allow file-read*
  (subpath "/bin") (subpath "/usr/bin") (subpath "/usr/sbin")
  (subpath "/sbin") (subpath "/etc") (subpath "/private/etc")
  (subpath "/dev")
  (subpath "/usr/local/bin") (subpath "/usr/local/sbin")
  (subpath "/usr/local/lib") (subpath "/usr/local/libexec")
  (subpath "/usr/local/share") (subpath "/usr/local/Cellar")
  (subpath "/usr/local/opt") (subpath "/usr/local/Frameworks")
  (subpath "/opt/homebrew/bin") (subpath "/opt/homebrew/sbin")
  (subpath "/opt/homebrew/lib") (subpath "/opt/homebrew/libexec")
  (subpath "/opt/homebrew/share") (subpath "/opt/homebrew/Cellar")
  (subpath "/opt/homebrew/opt") (subpath "/opt/homebrew/Frameworks")
  (subpath "/Library/Developer/CommandLineTools")
  (subpath (param "PROJECT"))
  (subpath (param "WORK")))
(allow file-write*
  (subpath (param "WORK")) (subpath "/dev") (literal (param "PIDFILE")))
(deny file-write* (subpath (param "SPILL")))
(deny file-write*
  (require-all (subpath (param "WORK")) (subpath (param "SPILL"))))
(deny process-exec (literal "/usr/bin/sudo") (literal "/usr/bin/su"))
(allow network*)
