# DHI+ runtime — native macOS. See docs/macos-native.md.
# Copy to .env (mode 600) in the directory you start dhi-server from.
DATABASE_URL=postgres://dhi_app:dhi_app@127.0.0.1:5432/dhi
MIGRATION_DATABASE_URL=postgres://dhi_owner:dhi_owner@127.0.0.1:5432/dhi
TEST_DATABASE_URL=postgres://dhi_test:dhi_test@127.0.0.1:5432/dhi
DHI_BIND=127.0.0.1:8080
RUST_LOG=dhi=info,tower_http=info
# Exported web UI served same-origin by dhi-server (default: web/out).
# DHI_WEB_DIR=web/out

# Native macOS task sandbox. Required. Point it at ops/macos/dhi-task.sb in
# this checkout: there is no install copy. The path must be absolute and name
# an existing regular file. Replace <you>; ~ and shell variables are not
# expanded.
DHI_SANDBOX_PROFILE=/Users/<you>/Desktop/dhi/ops/macos/dhi-task.sb

# Root for legacy task work folders and the per-task pidfiles in pids/.
# Absolute path. Project tasks use <project>/.dhi/<task-id> instead.
DHI_WORKSPACE_ROOT=/Users/Shared/dhi/work

# Project file browser: absolute root listed by the UI file browser. The
# server creates it when missing and refuses a symlink. Prefer
# /Users/Shared/... over ~/Desktop, ~/Documents, and ~/Downloads (TCC).
# Unset disables the file browser.
DHI_FILE_BROWSER_ROOT=/Users/Shared/dhi/projects

# Legacy project folders: comma-separated absolute paths kept for tasks
# created before the file browser. New tasks select a project folder
# through the file browser.
# Example: /Users/Shared/dhi/projects/build
# DHI_PROJECT_FOLDERS=/Users/Shared/dhi/projects/build

# River AI — OpenAI-compatible endpoint
DHI_LLM_BASE_URL=https://api.river.ai/v1
DHI_LLM_API_KEY=
DHI_LLM_PLANNER_MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017
DHI_LLM_WORKER_MODEL=zai-org/GLM-5.3-Flash

# The live smoke test is skipped unless this is 1.
DHI_LIVE_RIVER=0

# Web tools: web_search / web_read / web_research behind one
# provider router. DHI_WEB_PROVIDER selects auto (default), tinyfish,
# parallel, or firecrawl. Keys are optional only where noted; no key ships.
# Provider order is tinyfish -> parallel -> firecrawl for search/read;
# web_research uses Parallel only.
# DHI_WEB_PROVIDER=auto
# TINYFISH_API_KEY=
# TINYFISH_SEARCH_URL=
# TINYFISH_FETCH_URL=
# TINYFISH_FETCH_TIMEOUT_SECS=180
# PARALLEL_API_KEY=
# PARALLEL_BASE_URL=
# FIRECRAWL_BASE_URL=http://127.0.0.1:3002
# FIRECRAWL_API_KEY=
# FIRECRAWL_TIMEOUT_SECS=60
# DHI_WEB_TIMEOUT_SECS=60
# DHI_WEB_RESEARCH_TIMEOUT_SECS=900
# DHI_WEB_OPERATION_TIMEOUT_SECS=180
# DHI_WEB_CACHE_TTL_SECS=300
# DHI_WEB_ALLOW_PRIVATE_TARGETS=0
# The optional ~/.config/dhi/config.json (or DHI_CONFIG) firecrawl section
# is still honored; its key/base URL/timeout sit below the env overrides.
# DHI_CONFIG=~/.config/dhi/config.json
